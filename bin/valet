set -euo pipefail
VAULT="${VALET_VAULT:-$HOME/.concierge/vault.json}"
[ -r "$VAULT" ] || { echo "valet: vault missing: $VAULT" >&2; exit 1; }

get() {
  jq -r --arg p "$1" '
    to_entries[]
    | select(.value | objects)
    | select(.value.targets[]? == $p)
    | .value.token
  ' "$VAULT" 2>/dev/null | head -1
}

export MISTRAL_API_KEY="$(get mistral)"
export GEMINI_API_KEY="$(get gemini)"
export GOOGLE_GENERATIVE_AI_API_KEY="$(get gemini)"
export VALET_PRIMARY_ROUTING="$(get primary-routing)"
export VALET_ORCHESTRATOR="$(get orchestrator)"
export VALET_9ROUTER="$(get 9router)"
exec "$@"
